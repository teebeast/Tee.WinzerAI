{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WinzerAI",
  "version": "0.1.0",
  "identifier": "tee.winzerai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WinzerAI",
        "width": 1280,
        "height": 860,
        "minWidth": 400,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WinzerAI",
    "shortDescription": "Rundenbasierte Weingut-Simulation",
    "longDescription": "Rundenbasierte Weingut-Simulation – nachempfunden dem 90er-Klassiker Winzer.",
    "category": "SimulationGame",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
